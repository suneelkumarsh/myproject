{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "generate:http-error-config": "node ./scripts/generate-http-error-config.js",
    "preopenapi": "npm run generate:http-error-config && bash ./openapi/scripts/prepare-generator-jar.sh && npx openapi-merge-cli --config ./openapi/openapi-merge.json",
    "openapi": "npx openapi-generator-cli generate --generator-key v3.0 --silent",
    "prestart:e2e": "./e2e/compose/compose.sh && npm run openapi",
    "prestart": "npm run openapi",
    "start": "npx ng serve",
    "prelocal": "npm run openapi",
    "local": "npx ng serve --proxy-config local.proxy.config.json",
    "start:staging": "npm run start",
    "start:local": "npm run local",
    "start:e2e": "npx ng serve --configuration e2e",
    "prebuild": "npm run openapi",
    "build": "npx ng build",
    "pretest": "npm run openapi",
    "test": "npx ng test",
    "test:chrome": "npx ng test --code-coverage --browsers ChromeHeadless",
    "prelint": "npm run openapi",
    "lint": "npx ng lint",
    "e2e": "npx playwright test --project=local --project=local-mvp",
    "sonar": "sonar-scanner",
    "licenses": "license-report --output=html > ./portal_ui_licenses.html --config ./license-report-config.json",
    "prepare": "husky install",
    "smoke:do": "bash e2e/scripts/smokeTest.sh do",
    "smoke:do1": "bash e2e/scripts/smokeTest.sh do1",
    "smoke:preLab1": "bash e2e/scripts/smokeTest.sh preLab1",
    "smoke:preLab2": "bash e2e/scripts/smokeTest.sh preLab2"
